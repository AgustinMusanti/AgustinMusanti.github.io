---
import BaseLayout from './BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import WhatIDo from '../components/sections/WhatIDo.astro';
import Projects from '../components/sections/Projects.astro';
import WorkCases from '../components/sections/WorkCases.astro';
import HowIWork from '../components/sections/HowIWork.astro';
import Career from '../components/sections/Career.astro';
import Tools from '../components/sections/Tools.astro';
import Contact from '../components/sections/Contact.astro';
import { getProfile } from '../lib/content';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const profile = await getProfile(lang);
---

<BaseLayout lang={lang} title={`${profile.name} · ${profile.role}`} description={profile.heroTagline}>
  <Hero lang={lang} />
  <WhatIDo lang={lang} />
  <Projects lang={lang} />
  <WorkCases lang={lang} />
  <HowIWork lang={lang} />
  <Career lang={lang} />
  <Tools lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
