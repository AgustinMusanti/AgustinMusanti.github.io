---
import BaseLayout from './BaseLayout.astro';
import SojaEstimateChart from '../components/charts/SojaEstimateChart.astro';
import SojaMaeChart from '../components/charts/SojaMaeChart.astro';
import SojaImportance from '../components/charts/SojaImportance.astro';
import InflationChart from '../components/charts/InflationChart.astro';
import type { Project } from '../lib/content';
import { useTranslations, localizePath, type Language } from '../i18n/utils';

interface Props {
  lang: Language;
  project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { text, links, tags, stack, metric, visual, slug } = project;
const caseStudy = text.caseStudy!;
const ogImagePath = lang === 'en' ? `/og/en/project/${slug}.png` : `/og/project/${slug}.png`;

const blocks = [
  { label: t.caseStudy.problem, text: caseStudy.problem },
  { label: t.caseStudy.approach, text: caseStudy.approach },
  { label: t.caseStudy.result, text: caseStudy.result },
  { label: t.caseStudy.learnings, text: caseStudy.learnings },
];
---

<BaseLayout
  lang={lang}
  title={`${text.title} · Agustín Musanti`}
  description={text.result ?? text.summary}
  ogImagePath={ogImagePath}
>
  <article class="mx-auto max-w-4xl px-4 py-16">
    <a href={`${localizePath('/', lang)}#projects`} class="text-sm text-[var(--accent-3)] hover:underline">
      ← {t.caseStudy.back}
    </a>

    <h1 class="mt-6 text-3xl text-[var(--text)] md:text-4xl">{text.title}</h1>
    <p class="mt-3 text-lg text-[var(--muted)]">{text.question}</p>

    <p class="eyebrow mt-4">
      {tags.map((tag) => t.projects.tags[tag]).join(' · ')} · {text.sector}
    </p>

    {metric && (
      <p class="panel mt-8 p-5">
        <span class="num block text-4xl leading-none text-[var(--accent)]">{metric}</span>
        <span class="mt-2 block text-sm text-[var(--muted)]">{text.metricLabel}</span>
      </p>
    )}

    {visual === 'soja' && (
      <section class="mt-10" aria-label={t.caseStudy.charts}>
        <div class="panel p-4 md:p-6">
          <SojaEstimateChart lang={lang} />
        </div>
        <div class="mt-5 grid gap-5 md:grid-cols-2">
          <div class="panel p-4 md:p-5">
            <SojaMaeChart lang={lang} />
          </div>
          <div class="panel p-4 md:p-5">
            <SojaImportance lang={lang} />
          </div>
        </div>
      </section>
    )}
    {visual === 'inflation-seasonality' && (
      <section class="panel mt-10 p-4 md:p-6" aria-label={t.caseStudy.charts}>
        <InflationChart lang={lang} />
      </section>
    )}

    <div class="mt-10 space-y-8">
      {blocks.map((block) => (
        <section>
          <h2 class="eyebrow">{block.label}</h2>
          <p class="mt-2 text-[var(--text)]">{block.text}</p>
        </section>
      ))}
    </div>

    <section class="mt-10">
      <h2 class="eyebrow">{t.caseStudy.stack}</h2>
      <p class="mt-2 text-[var(--text)]">{stack.join(' · ')}</p>
    </section>

    {(links.repo || links.demo) && (
      <section class="mt-10">
        <h2 class="eyebrow">{t.caseStudy.links}</h2>
        <div class="mt-3 flex flex-wrap gap-3">
          {links.demo && (
            <a href={links.demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
              {t.projects.demo}
              <span class="sr-only"> {t.nav.openInNewTab}</span>
            </a>
          )}
          {links.repo && (
            <a href={links.repo} target="_blank" rel="noopener noreferrer" class="btn">
              {t.projects.repo}
              <span class="sr-only"> {t.nav.openInNewTab}</span>
            </a>
          )}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
