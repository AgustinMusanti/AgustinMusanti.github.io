---
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { getProjectsPersonal } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjectsPersonal('es');
  return projects
    .filter((project) => project.data.caseStudy)
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, tags, stack, repo, demo, caseStudy } = project.data;
if (!caseStudy) throw new Error(`Missing case study for ${project.id}`);
---

<CaseStudyLayout
  lang="es"
  slug={project.id}
  title={title}
  description={description}
  tags={tags}
  stack={stack}
  problem={caseStudy.problem}
  approach={caseStudy.approach}
  result={caseStudy.result}
  learnings={caseStudy.learnings}
  repo={repo}
  demo={demo}
/>
