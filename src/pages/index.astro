---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import ImpactCounters from '../components/sections/ImpactCounters.astro';
import About from '../components/sections/About.astro';
import Projects from '../components/sections/Projects.astro';
import Experience from '../components/sections/Experience.astro';
import Recognitions from '../components/sections/Recognitions.astro';
import Learning from '../components/sections/Learning.astro';
import Stack from '../components/sections/Stack.astro';
import Contact from '../components/sections/Contact.astro';
import { getEntry } from 'astro:content';

const lang = 'es' as const;
const profile = await getEntry('profile', 'main');
if (!profile) throw new Error('Missing profile content');
---

<BaseLayout lang={lang} title={`${profile.data.name} · ${profile.data.role}`} description={profile.data.heroTagline}>
  <Hero lang={lang} />
  <ImpactCounters />
  <About />
  <Projects lang={lang} />
  <Experience />
  <Recognitions />
  <Learning />
  <Stack />
  <Contact />
</BaseLayout>
