---
import { useTranslations, type Language } from '../../i18n/utils';
import { getProfile, getProjectsPersonal } from '../../lib/content';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const profile = await getProfile(lang);
const personalProjects = await getProjectsPersonal(lang);

const sectionCommands = [
  { id: 'about', label: t.nav.about, href: '#about' },
  { id: 'projects', label: t.nav.projects, href: '#projects' },
  { id: 'experience', label: t.nav.experience, href: '#experience' },
  { id: 'recognitions', label: t.nav.recognitions, href: '#recognitions' },
  { id: 'learning', label: t.nav.learning, href: '#learning' },
  { id: 'stack', label: t.nav.stack, href: '#stack' },
  { id: 'contact', label: t.nav.contact, href: '#contact' },
];

const projectCommands = personalProjects
  .filter((p) => p.data.caseStudy)
  .map((p) => ({
    id: `project-${p.id}`,
    label: p.data.title,
    href: lang === 'en' ? `/en/projects/${p.id}` : `/proyectos/${p.id}`,
  }));

const actionCommands = [
  { id: 'copy-email', label: t.commandPalette.copyEmail, action: 'copy-email' },
  { id: 'toggle-theme', label: t.commandPalette.toggleTheme, action: 'toggle-theme' },
  { id: 'toggle-lang', label: t.commandPalette.toggleLang, action: 'toggle-lang' },
];

const commands = [
  ...sectionCommands.map((c) => ({ ...c, kind: 'nav' })),
  ...projectCommands.map((c) => ({ ...c, kind: 'nav' })),
  ...actionCommands.map((c) => ({ ...c, kind: 'action' })),
];

const enHref = lang === 'en' ? '/' : '/en';
---

<dialog
  id="command-palette"
  class="w-full max-w-lg rounded-lg border border-[var(--border)] bg-[var(--surface)] p-0 text-[var(--text)] backdrop:bg-black/50"
  aria-label={t.commandPalette.placeholder}
  data-email={profile.email}
  data-en-href={enHref}
>
  <div class="flex items-center border-b border-[var(--border)] px-4 py-3">
    <input
      id="command-palette-input"
      type="text"
      placeholder={t.commandPalette.placeholder}
      class="w-full bg-transparent font-mono-data text-sm text-[var(--text)] outline-none placeholder:text-[var(--muted)]"
      autocomplete="off"
    />
    <span class="font-mono-data text-[10px] text-[var(--muted)]">{t.commandPalette.hint}</span>
  </div>
  <ul id="command-palette-list" class="max-h-80 overflow-y-auto py-2">
    {commands.map((command) => (
      <li>
        <button
          type="button"
          data-command-id={command.id}
          data-command-kind={command.kind}
          data-command-href={'href' in command ? command.href : undefined}
          data-command-action={'action' in command ? command.action : undefined}
          data-command-label={command.label.toLowerCase()}
          class="command-item w-full px-4 py-2 text-left text-sm hover:bg-[var(--bg)] aria-selected:bg-[var(--bg)]"
        >
          {command.label}
        </button>
      </li>
    ))}
  </ul>
  <p id="command-palette-empty" class="hidden px-4 py-6 text-center text-sm text-[var(--muted)]">
    {t.commandPalette.noResults}
  </p>
</dialog>

<script>
  const dialog = document.getElementById('command-palette') as HTMLDialogElement | null;
  const trigger = document.getElementById('command-palette-trigger');
  const input = document.getElementById('command-palette-input') as HTMLInputElement | null;
  const list = document.getElementById('command-palette-list');
  const empty = document.getElementById('command-palette-empty');
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.command-item'));
  let activeIndex = 0;

  function setActive(index: number) {
    const visible = items.filter((item) => item.parentElement && !item.parentElement.classList.contains('hidden'));
    if (visible.length === 0) return;
    activeIndex = (index + visible.length) % visible.length;
    visible.forEach((item, i) => item.setAttribute('aria-selected', String(i === activeIndex)));
    visible[activeIndex]?.scrollIntoView({ block: 'nearest' });
  }

  function openPalette() {
    dialog?.showModal();
    if (input) input.value = '';
    items.forEach((item) => (item.parentElement!.classList.remove('hidden')));
    empty?.classList.add('hidden');
    activeIndex = 0;
    setActive(0);
    input?.focus();
  }

  function filter() {
    const query = input?.value.trim().toLowerCase() ?? '';
    let visibleCount = 0;
    items.forEach((item) => {
      const matches = (item.dataset.commandLabel ?? '').includes(query);
      item.parentElement!.classList.toggle('hidden', !matches);
      if (matches) visibleCount += 1;
    });
    empty?.classList.toggle('hidden', visibleCount > 0);
    activeIndex = 0;
    setActive(0);
  }

  async function runAction(action: string) {
    if (action === 'copy-email') {
      const email = dialog?.dataset.email ?? '';
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        // clipboard unavailable; silently ignore
      }
    } else if (action === 'toggle-theme') {
      document.getElementById('theme-toggle')?.dispatchEvent(new MouseEvent('click'));
    } else if (action === 'toggle-lang') {
      const enHref = dialog?.dataset.enHref;
      if (enHref) window.location.href = enHref;
    }
  }

  function activateCommand(item: HTMLButtonElement) {
    const href = item.dataset.commandHref;
    const action = item.dataset.commandAction;
    dialog?.close();
    if (href) {
      window.location.href = href;
    } else if (action) {
      runAction(action);
    }
  }

  trigger?.addEventListener('click', openPalette);

  document.addEventListener('keydown', (event) => {
    const isShortcut = (event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k';
    if (isShortcut) {
      event.preventDefault();
      dialog?.open ? dialog.close() : openPalette();
    }
  });

  input?.addEventListener('input', filter);

  dialog?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown') {
      event.preventDefault();
      setActive(activeIndex + 1);
    } else if (event.key === 'ArrowUp') {
      event.preventDefault();
      setActive(activeIndex - 1);
    } else if (event.key === 'Enter') {
      event.preventDefault();
      const visible = items.filter((item) => !item.parentElement!.classList.contains('hidden'));
      const selected = visible[activeIndex];
      if (selected) activateCommand(selected);
    }
  });

  items.forEach((item) => item.addEventListener('click', () => activateCommand(item)));

  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
