---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button
  type="button"
  data-theme-toggle
  class="grid h-9 w-9 place-items-center rounded border border-[var(--border)] text-[var(--text)] transition hover:border-[var(--accent)]"
  aria-label={t.theme.toggleToDark}
>
  <svg
    class="theme-icon-dark h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
  </svg>
  <svg
    class="theme-icon-light hidden h-4 w-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<script>
  const STORAGE_KEY = 'theme';
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]'));

  function getStored(): 'light' | 'dark' | null {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function isDark(): boolean {
    const stored = getStored();
    if (stored) return stored === 'dark';
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function syncIcons() {
    const dark = isDark();
    buttons.forEach((button) => {
      button.querySelector('.theme-icon-dark')?.classList.toggle('hidden', dark);
      button.querySelector('.theme-icon-light')?.classList.toggle('hidden', !dark);
    });
  }

  function toggleTheme() {
    const next = isDark() ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {
      // storage unavailable; theme still applies for this page view
    }
    syncIcons();
  }

  buttons.forEach((button) => button.addEventListener('click', toggleTheme));

  syncIcons();
</script>
