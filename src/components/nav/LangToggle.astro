---
import { useTranslations, toEsPath, toEnPath, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);

const esHref = toEsPath(currentPath);
const enHref = toEnPath(currentPath);
---

<div class="flex items-center gap-1 text-xs" aria-label={t.langToggle.label}>
  <a
    href={esHref}
    class:list={[
      'rounded px-2 py-1',
      lang === 'es' ? 'text-[var(--accent)]' : 'text-[var(--muted)] hover:text-[var(--text)]',
    ]}
    aria-current={lang === 'es' ? 'true' : undefined}
  >
    ES
  </a>
  <span class="text-[var(--border)]">/</span>
  <a
    href={enHref}
    class:list={[
      'rounded px-2 py-1',
      lang === 'en' ? 'text-[var(--accent)]' : 'text-[var(--muted)] hover:text-[var(--text)]',
    ]}
    aria-current={lang === 'en' ? 'true' : undefined}
  >
    EN
  </a>
</div>
