---
import ProcessAnimation from './ProcessAnimation.astro';
import { getProfile } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { name, role, location, heroTagline, heroSecondary, linkedin, github } = await getProfile(lang);
---

<section class="mx-auto max-w-6xl px-4 pb-12 pt-10 md:pt-16">
  <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <div data-reveal>
      <p class="text-sm text-[var(--muted)]">{location}</p>
      <h1 class="mt-3 text-4xl leading-tight md:text-5xl">{name}</h1>
      <p class="mt-2 text-lg text-[var(--accent)] md:text-xl">{role}</p>
      <p class="mt-5 font-heading text-xl leading-snug text-[var(--text)] md:text-2xl">{heroTagline}</p>
      <p class="mt-4 max-w-xl text-base text-[var(--muted)]">{heroSecondary}</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#projects" class="btn btn-primary btn-arrow">
          {t.hero.viewProjects}
          <span aria-hidden="true">→</span>
        </a>
        <a href={linkedin} target="_blank" rel="noopener noreferrer" class="btn">
          LinkedIn<span class="sr-only"> {t.nav.openInNewTab}</span>
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn">
          GitHub<span class="sr-only"> {t.nav.openInNewTab}</span>
        </a>
      </div>
    </div>

    <div data-reveal style="--d:1">
      <ProcessAnimation lang={lang} />
    </div>
  </div>
</section>
