---
import PipelineDiagram from './PipelineDiagram.astro';
import { getProfile, getSiteConfig } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const { name, role, location, heroTagline, linkedin, github } = await getProfile(lang);
const { cvEnabled } = await getSiteConfig();
---

<section class="mx-auto max-w-5xl px-4 pb-16 pt-20 md:pt-28">
  <p class="font-mono-data text-sm text-[var(--muted)]">{location}</p>
  <h1 class="mt-4 text-4xl leading-tight md:text-6xl">{name}</h1>
  <p class="mt-3 text-lg text-[var(--accent)] md:text-xl">{role}</p>
  <p class="mt-6 max-w-2xl text-base text-[var(--text)] md:text-lg">{heroTagline}</p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <a
      href="#projects"
      class="rounded bg-[var(--accent)] px-5 py-2.5 font-mono-data text-sm text-[var(--bg)] transition hover:opacity-90"
    >
      {t.hero.viewProjects}
    </a>
    {cvEnabled && (
      <a
        href="/cv/CV_AgustinMusanti.pdf"
        class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
      >
        {t.hero.downloadCv}
      </a>
    )}
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      LinkedIn
      <span class="sr-only">{t.nav.openInNewTab}</span>
    </a>
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      GitHub
      <span class="sr-only">{t.nav.openInNewTab}</span>
    </a>
  </div>

  <div class="mt-16">
    <PipelineDiagram lang={lang} />
  </div>
</section>
