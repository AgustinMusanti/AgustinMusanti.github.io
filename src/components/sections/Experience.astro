---
import SectionHeading from '../ui/SectionHeading.astro';
import { getExperience } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const roles = await getExperience(lang);
---

<section id="experience" class="mx-auto max-w-5xl px-4 py-24">
  <SectionHeading index="05" title={t.nav.experience} />

  <ol class="relative border-l border-[var(--border)] pl-8">
    {roles.map((role) => (
      <li class="relative pb-12 last:pb-0">
        <span class="absolute -left-[37px] top-1 h-3 w-3 rounded-full border-2 border-[var(--accent)] bg-[var(--bg)]"></span>

        <p class="font-mono-data text-xs text-[var(--muted)]">{role.data.period}</p>
        <h3 class="mt-1 flex items-center gap-2 text-lg text-[var(--text)]">
          {role.data.title}
          {role.data.award && (
            <span title="PwC Te Reconoce" aria-label="PwC Te Reconoce award" class="text-[var(--accent)]">
              🏆
            </span>
          )}
        </h3>

        <ul class="mt-3 space-y-2 text-sm text-[var(--muted)]">
          {role.data.bullets.map((bullet) => (
            <li class="flex gap-2">
              <span class="text-[var(--accent-3)]">—</span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</section>
