---
import SectionHeading from '../ui/SectionHeading.astro';
import { getProfile } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { bio, role, currentFocus, location, languages, certification } = await getProfile(lang);

const facts = [
  { label: t.about.role, value: role },
  { label: t.about.focus, value: currentFocus },
  { label: t.about.location, value: location },
  { label: t.about.languages, value: languages.join(' · ') },
  { label: t.about.certification, value: certification },
];
---

<section id="about" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.about} />

  <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
    <div class="space-y-4 text-[var(--text)]">
      {bio.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>

    <dl class="panel divide-y divide-[var(--border)] self-start">
      {facts.map((fact) => (
        <div class="px-5 py-3">
          <dt class="eyebrow">{fact.label}</dt>
          <dd class="mt-1 text-sm text-[var(--text)]">{fact.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
