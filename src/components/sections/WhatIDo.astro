---
import { getHighlights } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const items = await getHighlights(lang);
---

<section class="mx-auto max-w-6xl px-4 pb-8" aria-labelledby="what-i-do">
  <h2 id="what-i-do" class="sr-only">
    {t.whatIDo.title}
  </h2>
  <ul class="grid grid-cols-2 gap-3 lg:grid-cols-4">
    {items.map((item, i) => (
      <li class="panel lift p-4 md:p-5" data-reveal style={`--d:${i}`}>
        {item.data.value ? (
          <>
            <p class="num text-3xl leading-none text-[var(--accent)] md:text-4xl" data-count={item.data.value}>
              {item.data.value}
            </p>
            <p class="mt-2 text-sm text-[var(--muted)]">{item.data.label}</p>
          </>
        ) : (
          <p class="font-heading text-base leading-snug text-[var(--text)] md:text-lg">{item.data.label}</p>
        )}
      </li>
    ))}
  </ul>
</section>
