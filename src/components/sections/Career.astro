---
import SectionHeading from '../ui/SectionHeading.astro';
import { getExperience } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const roles = await getExperience(lang);
---

<section id="career" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.path} />

  <ol class="relative ml-1.5 border-l border-[var(--border)] pl-7">
    {roles.map(({ data: role }, i) => (
      <li class="relative pb-10 last:pb-0" data-reveal style={`--d:${i}`}>
        <span class="absolute -left-[35px] top-1.5 h-3 w-3 rounded-full border-2 border-[var(--accent)] bg-[var(--bg)]" />
        {role.promotion && (
          <p class="mb-1.5 inline-flex whitespace-nowrap rounded-full border border-[var(--accent-2)] px-2 py-0.5 text-xs text-[var(--accent-2)]">
            ↑ {t.path.promotion}
          </p>
        )}
        <p class="text-sm text-[var(--muted)]">
          {role.period} · {role.company}
        </p>
        <h3 class="mt-1 text-lg text-[var(--text)]">{role.title}</h3>
        <p class="mt-1 max-w-2xl text-[var(--muted)]">{role.summary}</p>
        {role.award && (
          <p class="mt-3 inline-flex max-w-2xl items-start gap-2 rounded-lg border border-[var(--accent)] bg-[var(--surface)] px-3 py-2 text-sm">
            <span aria-hidden="true">🏆</span>
            <span>
              <span class="font-medium text-[var(--accent)]">
                {t.path.award} {role.award.title}
              </span>
              <span class="text-[var(--text)]"> · {role.award.description}</span>
            </span>
          </p>
        )}
      </li>
    ))}
  </ol>
</section>
