---
import SectionHeading from '../ui/SectionHeading.astro';
import { getExperience } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const roles = await getExperience(lang);
// Odd entries are the figures ("4 horas", "10 minutos"), rendered in gold mono; the text stays as written.
const splitFigures = (text: string) => text.split(/(\d+(?:[.,]\d+)?\s?(?:horas|minutos|hours|minutes)\b)/);
---

<section id="career" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.path} />

  <ol class="relative ml-1.5 border-l border-[var(--border)] pl-7">
    {roles.map(({ data: role }, i) => (
      <li
        class="relative pb-10 last:pb-0 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] md:gap-8"
        data-reveal
        style={`--d:${i}`}
      >
        <span
          class:list={[
            'absolute -left-[35px] top-1.5 h-3 w-3 rounded-full border-2 border-[var(--accent)]',
            i === 0 ? 'bg-[var(--accent)] ring-4 ring-[var(--accent)]/20' : 'bg-[var(--bg)]',
          ]}
        />
        <div>
          {role.promotion && (
            <p class="mb-1.5 inline-flex whitespace-nowrap rounded-full border border-[var(--accent-2)] px-2 py-0.5 text-xs text-[var(--accent-2)]">
              ↑ {t.path.promotion}
            </p>
          )}
          <p class="text-sm text-[var(--muted)]">
            {role.period} · {role.company}
          </p>
          <h3 class="mt-1 text-lg text-[var(--text)]">{role.title}</h3>
          <p class="mt-1 max-w-2xl text-[var(--muted)]">{role.summary}</p>
        </div>
        {role.award && (
          <p class="mt-3 flex items-start gap-2 self-start rounded-lg border border-[var(--accent)] bg-[var(--surface)] px-3 py-2 text-sm md:mt-6">
            <svg
              aria-hidden="true"
              viewBox="0 0 24 24"
              class="mt-0.5 h-4 w-4 shrink-0 text-[var(--accent)]"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M8 4h8v5a4 4 0 0 1-8 0V4Z" />
              <path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M9 20h6" />
            </svg>
            <span>
              <span class="font-medium text-[var(--accent)]">
                {t.path.award} {role.award.title}
              </span>
              <span class="text-[var(--text)]">
                {' · '}
                {splitFigures(role.award.description).map((part, j) =>
                  j % 2 ? <span class="stat-inline">{part}</span> : part,
                )}
              </span>
            </span>
          </p>
        )}
      </li>
    ))}
  </ol>
</section>
