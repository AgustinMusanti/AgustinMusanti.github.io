---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;

function pickMotif(tagList: string[]): string {
  const has = (needle: string) => tagList.some((tag) => tag.toLowerCase().includes(needle));
  if (has('machine learning') || has('ia') || has('satelital')) return 'network';
  if (has('sql') || has('base')) return 'database';
  if (has('power bi') || has('bi')) return 'chart';
  if (has('automat') || has('power automate')) return 'flow';
  if (has('python') || has('astro') || has('web')) return 'brackets';
  return 'grid';
}

const motif = pickMotif(tags);
---

<svg viewBox="0 0 120 80" class="h-20 w-full" aria-hidden="true" focusable="false">
  <rect x="1" y="1" width="118" height="78" rx="4" fill="none" stroke="var(--border)" stroke-width="1" />

  {motif === 'network' && (
    <g stroke="var(--accent-3)" stroke-width="1.5" fill="none">
      <circle cx="30" cy="40" r="4" fill="var(--accent-3)" stroke="none" />
      <circle cx="60" cy="22" r="4" fill="var(--accent-2)" stroke="none" />
      <circle cx="60" cy="58" r="4" fill="var(--accent-2)" stroke="none" />
      <circle cx="90" cy="40" r="4" fill="var(--accent)" stroke="none" />
      <path d="M30 40 L60 22 M30 40 L60 58 M60 22 L90 40 M60 58 L90 40" />
    </g>
  )}

  {motif === 'database' && (
    <g stroke="var(--accent-3)" stroke-width="1.5" fill="none">
      <ellipse cx="60" cy="24" rx="22" ry="7" />
      <path d="M38 24 V56 a22 7 0 0 0 44 0 V24" />
      <path d="M38 40 a22 7 0 0 0 44 0" />
    </g>
  )}

  {motif === 'chart' && (
    <g>
      <rect x="30" y="40" width="10" height="24" fill="var(--accent-2)" />
      <rect x="48" y="28" width="10" height="36" fill="var(--accent)" />
      <rect x="66" y="48" width="10" height="16" fill="var(--accent-3)" />
      <rect x="84" y="20" width="10" height="44" fill="var(--accent-2)" />
      <line x1="24" y1="66" x2="98" y2="66" stroke="var(--border)" stroke-width="1" />
    </g>
  )}

  {motif === 'flow' && (
    <g stroke="var(--accent-2)" stroke-width="1.5" fill="none">
      <rect x="20" y="32" width="24" height="16" rx="3" />
      <rect x="76" y="32" width="24" height="16" rx="3" />
      <path d="M44 40 H76" marker-end="url(#arrow)" />
      <circle cx="60" cy="18" r="3" fill="var(--accent)" stroke="none" />
      <circle cx="60" cy="62" r="3" fill="var(--accent)" stroke="none" />
      <path d="M60 24 V34 M60 46 V56" stroke-dasharray="2 2" />
    </g>
  )}

  {motif === 'brackets' && (
    <g stroke="var(--accent-3)" stroke-width="2" fill="none" stroke-linecap="round">
      <path d="M44 20 L28 40 L44 60" />
      <path d="M76 20 L92 40 L76 60" />
      <line x1="56" y1="56" x2="64" y2="24" stroke="var(--accent)" />
    </g>
  )}

  {motif === 'grid' && (
    <g stroke="var(--border)" stroke-width="1">
      <line x1="20" y1="20" x2="100" y2="20" />
      <line x1="20" y1="40" x2="100" y2="40" />
      <line x1="20" y1="60" x2="100" y2="60" />
      <line x1="20" y1="20" x2="20" y2="60" />
      <line x1="60" y1="20" x2="60" y2="60" />
      <line x1="100" y1="20" x2="100" y2="60" />
      <circle cx="40" cy="30" r="2.5" fill="var(--accent)" stroke="none" />
      <circle cx="80" cy="50" r="2.5" fill="var(--accent-2)" stroke="none" />
    </g>
  )}
</svg>
