---
import SectionHeading from '../ui/SectionHeading.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import { getEntry } from 'astro:content';

const profile = await getEntry('profile', 'main');
const siteConfig = await getEntry('siteConfig', 'main');
if (!profile || !siteConfig) throw new Error('Missing profile or siteConfig content');

const { email, linkedin, github } = profile.data;
const { cvEnabled } = siteConfig.data;
---

<section id="contact" class="mx-auto max-w-5xl px-4 py-24">
  <SectionHeading index="09" title="Contacto" />

  <h3 class="max-w-xl text-2xl text-[var(--text)] md:text-3xl">¿Charlamos sobre datos, automatización o IA aplicada?</h3>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <CopyEmailButton email={email} />
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      LinkedIn<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      GitHub<span class="sr-only"> (se abre en una pestaña nueva)</span>
    </a>
    {cvEnabled && (
      <a
        href="/cv/CV_AgustinMusanti.pdf"
        class="rounded bg-[var(--accent)] px-5 py-2.5 font-mono-data text-sm text-[var(--bg)] transition hover:opacity-90"
      >
        Descargar CV
      </a>
    )}
  </div>
</section>
