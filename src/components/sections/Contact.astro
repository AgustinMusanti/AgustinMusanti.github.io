---
import SectionHeading from '../ui/SectionHeading.astro';
import CopyEmailButton from '../ui/CopyEmailButton.astro';
import { getProfile, getSiteConfig } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const { email, linkedin, github } = await getProfile(lang);
const { cvEnabled } = await getSiteConfig();
---

<section id="contact" class="mx-auto max-w-5xl px-4 py-24">
  <SectionHeading index="09" title={t.nav.contact} />

  <h3 class="max-w-xl text-2xl text-[var(--text)] md:text-3xl">{t.contact.question}</h3>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <CopyEmailButton lang={lang} email={email} />
    <a
      href={linkedin}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      LinkedIn<span class="sr-only"> {t.nav.openInNewTab}</span>
    </a>
    <a
      href={github}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded border border-[var(--border)] px-5 py-2.5 font-mono-data text-sm text-[var(--text)] transition hover:border-[var(--accent)]"
    >
      GitHub<span class="sr-only"> {t.nav.openInNewTab}</span>
    </a>
    {cvEnabled && (
      <a
        href="/cv/CV_AgustinMusanti.pdf"
        class="rounded bg-[var(--accent)] px-5 py-2.5 font-mono-data text-sm text-[var(--bg)] transition hover:opacity-90"
      >
        {t.hero.downloadCv}
      </a>
    )}
  </div>
</section>
