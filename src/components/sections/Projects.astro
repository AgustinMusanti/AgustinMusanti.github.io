---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectFilter from './ProjectFilter.astro';
import ProjectCard from './ProjectCard.astro';
import { getProjectsProfessional, getProjectsPersonal } from '../../lib/content';
import { getRepoMeta } from '../../lib/github';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const professional = await getProjectsProfessional(lang);
const personal = await getProjectsPersonal(lang);

const personalWithMeta = await Promise.all(
  personal.map(async (project) => ({
    project,
    repoMeta: project.data.repo ? await getRepoMeta(project.data.repo, lang) : null,
  })),
);

const allTags = Array.from(new Set([...professional, ...personal].flatMap((p) => p.data.tags))).sort();
---

<section id="projects" class="mx-auto max-w-5xl px-4 py-24">
  <SectionHeading index="04" title={t.nav.projects} />

  <ProjectFilter lang={lang} tags={allTags} />

  <h3 class="mb-4 font-mono-data text-sm uppercase tracking-wide text-[var(--muted)]">{t.projects.personalGroup}</h3>
  <div class="grid gap-5 sm:grid-cols-2">
    {personalWithMeta.map(({ project, repoMeta }) => (
      <ProjectCard
        lang={lang}
        title={project.data.title}
        type={t.projects.personalType}
        description={project.data.description}
        tags={project.data.tags}
        href={
          project.data.caseStudy
            ? lang === 'en'
              ? `/en/projects/${project.id}`
              : `/proyectos/${project.id}`
            : undefined
        }
        repo={project.data.repo}
        demo={project.data.demo}
        repoMeta={repoMeta}
        featured={project.data.featured}
      />
    ))}
  </div>

  <h3 class="mb-4 mt-12 font-mono-data text-sm uppercase tracking-wide text-[var(--muted)]">
    {t.projects.professionalGroup}
  </h3>
  <div class="grid gap-5 sm:grid-cols-2">
    {professional.map((project) => (
      <ProjectCard
        lang={lang}
        title={project.data.title}
        type={t.projects.professionalType}
        description={project.data.description}
        tags={project.data.tags}
      />
    ))}
  </div>
</section>
