---
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectFilter from './ProjectFilter.astro';
import ProjectCard from './ProjectCard.astro';
import { TAGS, type Tag } from '../../lib/taxonomy';
import { getProjects } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = (await getProjects(lang)).filter((p) => p.kind === 'personal');

const counts = TAGS.map((tag) => [tag, projects.filter((p) => p.tags.includes(tag)).length] as const).filter(
  ([, n]) => n > 0,
) as [Tag, number][];
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.projects} />

  <ProjectFilter lang={lang} counts={counts} total={projects.length} />

  <div class="grid gap-5 md:grid-cols-2">
    {projects.map((project, i) => (
      <ProjectCard lang={lang} project={project} index={i} />
    ))}
  </div>

  <p class="mt-10 text-sm text-[var(--muted)]">{t.projects.moreSoon}</p>
</section>
