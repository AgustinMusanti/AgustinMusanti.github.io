---
import SectionHeading from '../ui/SectionHeading.astro';
import { getStack } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const categories = await getStack(lang);
const allTools = categories.flatMap((c) => c.data.tools);
---

<section id="tools" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.tools} />

  <div class="marquee mb-10" data-reveal>
    <div class="marquee-track">
      {[false, true].map((copy) => (
        <ul class="flex gap-3" aria-hidden={copy ? 'true' : undefined}>
          {allTools.map((tool) => (
            <li class="whitespace-nowrap rounded-full border border-[var(--border)] bg-[var(--surface)] px-4 py-2 font-heading text-base text-[var(--text)]">
              {tool}
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>

  <dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {categories.map(({ data }, i) => (
      <div class="panel p-5" data-reveal style={`--d:${i % 3}`}>
        <dt class="eyebrow">{data.label}</dt>
        <dd class="mt-2 text-sm text-[var(--text)]">{data.tools.join(' · ')}</dd>
      </div>
    ))}
  </dl>

  <p class="mt-6 text-sm text-[var(--muted)]">{t.tools.footnote}</p>
</section>
