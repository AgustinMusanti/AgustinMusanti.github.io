---
import SectionHeading from '../ui/SectionHeading.astro';
import { getStack } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const categories = await getStack(lang);
// On a 6-track grid, a last row of two splits it in halves instead of leaving one card alone.
const lastRowOfTwo = categories.length % 3 === 2;
const span = (i: number) => (lastRowOfTwo && i >= categories.length - 2 ? 'lg:col-span-3' : 'lg:col-span-2');
---

<section id="tools" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.tools} />

  <dl class="grid gap-5 sm:grid-cols-2 lg:grid-cols-6">
    {categories.map(({ data }, i) => (
      <div class:list={['panel p-5', span(i)]} data-reveal style={`--d:${i % 3}`}>
        <dt class="eyebrow">{data.label}</dt>
        <dd class="mt-2 text-sm text-[var(--text)]">{data.tools.join(' · ')}</dd>
      </div>
    ))}
  </dl>

  <p class="mt-6 text-sm text-[var(--muted)]">{t.tools.footnote}</p>
</section>
