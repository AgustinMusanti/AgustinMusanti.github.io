---
import { useTranslations, type Language } from '../../i18n/utils';

interface Tab {
  category: string;
  label: string;
}

interface Props {
  lang: Language;
  tabs: Tab[];
}

const { lang, tabs } = Astro.props;
const t = useTranslations(lang);
---

<div class="mb-8 flex flex-wrap gap-2" role="tablist" aria-label="Filter stack by category">
  <button
    type="button"
    data-stack-tab="all"
    aria-pressed="true"
    class="stack-tab-btn rounded-full border border-[var(--accent)] px-3 py-1 font-mono-data text-xs text-[var(--accent)] transition"
  >
    {t.stack.allCategories}
  </button>
  {tabs.map((tab) => (
    <button
      type="button"
      data-stack-tab={tab.category}
      aria-pressed="false"
      class="stack-tab-btn rounded-full border border-[var(--border)] px-3 py-1 font-mono-data text-xs text-[var(--muted)] transition hover:border-[var(--accent)] hover:text-[var(--text)]"
    >
      {tab.label}
    </button>
  ))}
</div>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.stack-tab-btn'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-stack-category]'));

  function applyTab(category: string) {
    groups.forEach((group) => {
      const show = category === 'all' || group.dataset.stackCategory === category;
      group.classList.toggle('hidden', !show);
    });

    buttons.forEach((button) => {
      const isActive = button.dataset.stackTab === category;
      button.setAttribute('aria-pressed', String(isActive));
      button.classList.toggle('border-[var(--accent)]', isActive);
      button.classList.toggle('text-[var(--accent)]', isActive);
      button.classList.toggle('border-[var(--border)]', !isActive);
      button.classList.toggle('text-[var(--muted)]', !isActive);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => applyTab(button.dataset.stackTab ?? 'all'));
  });
</script>
