---
import SectionHeading from '../ui/SectionHeading.astro';
import { getHowIWork } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { paragraphs, note } = await getHowIWork(lang);
---

<section id="how-i-work" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.howIWork} />

  <ul class="max-w-3xl divide-y divide-[var(--border)] border-y border-[var(--border)]">
    {paragraphs.map((paragraph, i) => (
      <li class="py-5 md:text-lg" data-reveal style={`--d:${i % 2}`}>
        <p class="measure text-[var(--text)]">{paragraph}</p>
      </li>
    ))}
  </ul>

  <p class="mt-6 max-w-3xl text-[var(--text)]" data-reveal>
    {note}
  </p>
</section>
