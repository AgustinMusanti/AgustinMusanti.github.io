---
import SectionHeading from '../ui/SectionHeading.astro';
import { getHowIWork } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { paragraphs, note } = await getHowIWork(lang);
---

<section id="how-i-work" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.howIWork} />

  <div class="grid gap-5 md:grid-cols-2">
    {paragraphs.map((paragraph, i) => (
      <p class="panel p-5 text-[var(--text)] md:text-lg" data-reveal style={`--d:${i % 2}`}>
        {paragraph}
      </p>
    ))}
  </div>

  <p class="mt-6 text-sm text-[var(--muted)]" data-reveal>
    {note}
  </p>
</section>
