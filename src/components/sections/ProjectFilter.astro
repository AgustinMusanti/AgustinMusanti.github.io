---
import type { Tag } from '../../lib/taxonomy';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
  counts: [Tag, number][];
  total: number;
}

const { lang, counts, total } = Astro.props;
const t = useTranslations(lang);
const showing = t.projects.showing;
const base = 'tag-filter-btn rounded-full border px-3 py-1 text-sm transition';
---

<div class="mb-8 flex flex-wrap gap-2" role="group" aria-label={t.projects.filterLabel}>
  <button
    type="button"
    data-tag-filter="all"
    aria-pressed="true"
    class={`${base} border-[var(--accent)] text-[var(--accent)]`}
  >
    {t.projects.allTags} <span class="num text-xs">{total}</span>
  </button>
  {counts.map(([tag, count]) => (
    <button
      type="button"
      data-tag-filter={tag}
      aria-pressed="false"
      class={`${base} border-[var(--border)] text-[var(--muted)] hover:border-[var(--accent)] hover:text-[var(--text)]`}
    >
      {t.projects.tags[tag]} <span class="num text-xs">{count}</span>
    </button>
  ))}
</div>
<p class="sr-only" role="status" data-filter-status data-template={showing}></p>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tag-filter-btn'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tags]'));

  const statusEl = document.querySelector<HTMLElement>('[data-filter-status]');
  const template = statusEl?.dataset.template ?? '';

  function applyFilter(tag: string) {
    let visible = 0;
    cards.forEach((card) => {
      const show = tag === 'all' || (card.dataset.tags ?? '').split(',').includes(tag);
      card.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });
    if (statusEl && tag !== 'all')
      statusEl.textContent = template.replace('{n}', String(visible)).replace('{total}', String(cards.length));
    else if (statusEl) statusEl.textContent = '';
    buttons.forEach((button) => {
      const active = button.dataset.tagFilter === tag;
      button.setAttribute('aria-pressed', String(active));
      button.classList.toggle('border-[var(--accent)]', active);
      button.classList.toggle('text-[var(--accent)]', active);
      button.classList.toggle('border-[var(--border)]', !active);
      button.classList.toggle('text-[var(--muted)]', !active);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const tag = button.dataset.tagFilter ?? 'all';
      const url = new URL(window.location.href);
      if (tag === 'all') url.searchParams.delete('tag');
      else url.searchParams.set('tag', tag);
      history.replaceState({}, '', url);
      applyFilter(tag);
    });
  });

  const initial = new URLSearchParams(window.location.search).get('tag');
  if (initial && buttons.some((b) => b.dataset.tagFilter === initial)) applyFilter(initial);
</script>
