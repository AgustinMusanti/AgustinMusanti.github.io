---
import SojaMaeChart from '../charts/SojaMaeChart.astro';
import InflationChart from '../charts/InflationChart.astro';
import DashboardGlyph from '../charts/DashboardGlyph.astro';
import type { Project } from '../../lib/content';
import { useTranslations, projectPath, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
  project: Project;
}

const { lang, project } = Astro.props;
const t = useTranslations(lang);
const { text, links, tags, stack, metric, visual, featured, kind, slug } = project;
const href = text.caseStudy ? projectPath(slug, lang) : undefined;
const professional = kind === 'profesional';
---

<article
  class:list={[
    'panel flex flex-col p-5 transition hover:border-[var(--accent)]',
    featured && 'md:col-span-2 md:grid md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-8',
  ]}
  data-tags={tags.join(',')}
>
  {!professional && visual && (
    <div class:list={['mb-5', featured && 'md:order-2 md:mb-0']}>
      {visual === 'soja' && <SojaMaeChart lang={lang} size="sm" />}
      {visual === 'inflation-seasonality' && <InflationChart lang={lang} />}
      {visual === 'dashboard' && <DashboardGlyph />}
    </div>
  )}

  <div class="flex flex-1 flex-col">
    {metric && (
      <p class="mb-3">
        <span class="num block text-3xl leading-none text-[var(--accent)]">{metric}</span>
        <span class="mt-1 block text-xs text-[var(--muted)]">{text.metricLabel}</span>
      </p>
    )}

    <h3 class="text-lg leading-snug text-[var(--text)]">
      {href ? (
        <a href={href} class="hover:text-[var(--accent)]">
          {text.title}
        </a>
      ) : (
        text.title
      )}
    </h3>

    <dl class="mt-3 space-y-2 text-sm">
      <div>
        <dt class="eyebrow">{t.projects.question}</dt>
        <dd class="mt-0.5 text-[var(--text)]">{text.question}</dd>
      </div>
      <div>
        <dt class="eyebrow">{t.projects.result}</dt>
        <dd class="mt-0.5 text-[var(--text)]">{text.result}</dd>
      </div>
      <div>
        <dt class="eyebrow">{t.projects.tools}</dt>
        <dd class="mt-0.5 text-[var(--muted)]">{stack.join(' · ')}</dd>
      </div>
    </dl>

    {text.process && (
      <div class="mt-4 grid grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-stretch gap-2 text-xs">
        <div class="rounded-md border border-[var(--border)] bg-[var(--bg)] p-2">
          <span class="eyebrow block">{t.projects.before}</span>
          <span class="mt-0.5 block text-[var(--muted)]">{text.process.before}</span>
        </div>
        <span class="self-center text-[var(--muted)]" aria-hidden="true">
          →
        </span>
        <div class="rounded-md border border-[var(--accent)] bg-[var(--bg)] p-2">
          <span class="eyebrow block">{t.projects.after}</span>
          <span class="mt-0.5 block text-[var(--text)]">{text.process.after}</span>
        </div>
      </div>
    )}

    <ul class="mt-4 flex flex-wrap gap-1.5">
      {tags.map((tag) => (
        <li class="rounded-full bg-[var(--bg)] px-2.5 py-0.5 text-xs text-[var(--muted)]">{t.projects.tags[tag]}</li>
      ))}
    </ul>

    {(href || links.demo || links.repo) && (
      <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-4 text-sm">
        {href && (
          <a href={href} class="font-medium text-[var(--accent)] hover:underline">
            {t.projects.viewCase} →
          </a>
        )}
        {links.demo && (
          <a href={links.demo} target="_blank" rel="noopener noreferrer" class="text-[var(--accent-3)] hover:underline">
            {t.projects.demo}
            <span class="sr-only"> {t.nav.openInNewTab}</span>
          </a>
        )}
        {links.repo && (
          <a href={links.repo} target="_blank" rel="noopener noreferrer" class="text-[var(--muted)] hover:underline">
            {t.projects.repo}
            <span class="sr-only"> {t.nav.openInNewTab}</span>
          </a>
        )}
      </div>
    )}
  </div>
</article>
