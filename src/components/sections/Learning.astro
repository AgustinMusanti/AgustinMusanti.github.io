---
import SectionHeading from '../ui/SectionHeading.astro';
import { getLearning } from '../../lib/content';
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const { title, text, principles } = await getLearning(lang);
---

<section id="learning" class="mx-auto max-w-6xl px-4 py-20">
  <SectionHeading title={t.nav.learning} />

  <h3 class="text-xl text-[var(--text)]">{title}</h3>
  <p class="mt-4 max-w-2xl text-[var(--muted)]">{text}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-3">
    {principles.map((principle) => (
      <div class="panel p-5">
        <h4 class="text-sm text-[var(--accent)]">{principle.title}</h4>
        <p class="mt-2 text-sm text-[var(--muted)]">{principle.description}</p>
      </div>
    ))}
  </div>
</section>
