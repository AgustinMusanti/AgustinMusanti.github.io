---
interface Props {
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<div class="mb-10 flex items-baseline gap-4">
  <span class="font-mono-data text-sm text-[var(--accent)]">{index} /</span>
  <h2 class="text-2xl text-[var(--text)] md:text-3xl">{title}</h2>
  <span class="h-px flex-1 bg-[var(--border)]"></span>
</div>
