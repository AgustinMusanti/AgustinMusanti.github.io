---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;

const match = value.match(/^([+~]?)(\d+(?:[.,]\d+)?)(.*)$/);
const prefix = match?.[1] ?? '';
const numberText = match?.[2] ?? '';
const suffix = match?.[3] ?? '';
const canAnimate = Boolean(match);
const targetNumber = canAnimate ? Number(numberText.replace(',', '.')) : 0;
const decimals = numberText.includes(',') || numberText.includes('.') ? numberText.split(/[.,]/)[1]?.length ?? 0 : 0;
---

<div class="border-t border-[var(--border)] pt-4">
  <p
    class="counter font-mono-data text-4xl text-[var(--accent)] md:text-5xl"
    data-animate={canAnimate ? 'true' : undefined}
    data-prefix={prefix}
    data-target={targetNumber}
    data-decimals={decimals}
    data-suffix={suffix}
  >
    {value}
  </p>
  <p class="mt-2 font-mono-data text-xs uppercase tracking-wide text-[var(--muted)]">{label}</p>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const counters = document.querySelectorAll<HTMLElement>('.counter[data-animate="true"]');

  if (!reduceMotion && counters.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.target);
          const prefix = el.dataset.prefix ?? '';
          const suffix = el.dataset.suffix ?? '';
          const decimals = Number(el.dataset.decimals ?? '0');
          const duration = 1200;
          const start = performance.now();

          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const current = target * progress;
            el.textContent = `${prefix}${current.toFixed(decimals)}${suffix}`;
            if (progress < 1) {
              requestAnimationFrame(tick);
            } else {
              el.textContent = `${prefix}${target.toFixed(decimals)}${suffix}`;
            }
          }

          requestAnimationFrame(tick);
          obs.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );

    counters.forEach((counter) => observer.observe(counter));
  }
</script>
