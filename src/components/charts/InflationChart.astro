---
import ChartFrame from './ChartFrame.astro';
import inflacion from '../../data/inflacion.json';
import { scale } from '../../lib/chart';
import { useTranslations, formatNumber, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang).inflation;
const fmt = (v: number) => formatNumber(v, lang, 2);

const w = 340;
const h = 130;
const m = { l: 4, r: 26, t: 10, b: 18 };
const values = inflacion.monthlyAverage;
const band = (w - m.l - m.r) / values.length;
const x = (i: number) => m.l + (i + 0.5) * band;
const y = scale([0, 7.5], [h - m.b, m.t]);
const threshold = 5;
// The peak month is the headline; other months above the threshold use a lighter step of the same gold.
const peak = Math.max(...values);
const barFill = (v: number) =>
  v === peak
    ? 'var(--chart-highlight)'
    : v > threshold
      ? 'color-mix(in srgb, var(--chart-highlight) 55%, var(--surface))'
      : 'var(--chart-secondary)';
---

<ChartFrame title={t.chartTitle} size="sm">
  <svg class="block h-auto w-full" viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
    <line x1={m.l} x2={w - m.r + 2} y1={y(threshold)} y2={y(threshold)} stroke="var(--muted)" stroke-dasharray="3 3" />
    <text x={w - 2} y={y(threshold) + 3.5} text-anchor="end" class="num" font-size="9.5" fill="var(--muted)">
      5%
    </text>
    {values.map((v, i) => (
      <g>
        <rect
          x={x(i) - band * 0.32}
          width={band * 0.64}
          y={y(v)}
          height={y(0) - y(v)}
          rx="2"
          class="draw-bar"
          style={`--i:${i}`}
          fill={barFill(v)}
          data-tip={`${t.monthsFull[i]} · ${fmt(v)}%`}
        />
        <text x={x(i)} y={h - 4} text-anchor="middle" font-size="10" fill="var(--muted)">
          {t.months[i]}
        </text>
      </g>
    ))}
  </svg>
  <div class="sr-only">
    <table>
      <caption>{t.tableCaption}</caption>
      <tbody>
        {values.map((v, i) => (
          <tr>
            <th scope="row">{t.monthsFull[i]}</th>
            <td>{fmt(v)}%</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ChartFrame>
