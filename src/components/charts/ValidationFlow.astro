---
import { useTranslations, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { cases } = useTranslations(lang);
const loop = 8;
const step = 1.2;
const numbers = [1, 2, 3, 4, 5];
---

<div class="vflow" role="img" aria-label={cases.flowDescription} style={`--loop:${loop}s;--step:${step}s`}>
  <div aria-hidden="true">
    <ol class="flow mt-0">
      {cases.flowSteps.map((label, i) => (
        <li class="flow-item" style={`--i:${i}`}>
          <span class:list={['flow-step is-auto', i === cases.flowHumanStep && 'is-human']}>
            <span class="flow-dot" />
            <span class="num text-xs opacity-60">{numbers[i]}</span>
            {label}
          </span>
        </li>
      ))}
    </ol>
    <p class="exception mt-3 inline-flex max-w-full items-start gap-2 rounded-lg border border-dashed border-[var(--accent-3)] px-3 py-2 text-sm text-[var(--muted)]">
      <span class="num text-xs text-[var(--accent-3)]">↺</span>
      <span>{cases.flowException}</span>
    </p>
  </div>
</div>

<style>
  .flow-step {
    white-space: normal;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vflow .flow-dot {
      animation: flow-travel var(--loop) linear infinite;
      animation-delay: calc(var(--i) * var(--step));
    }
    .exception {
      animation: exception-pulse var(--loop) ease-in-out infinite;
      animation-delay: var(--step);
    }
    .vflow:hover * {
      animation-play-state: paused;
    }
  }
  @keyframes exception-pulse {
    0%,
    100% {
      background: transparent;
    }
    6%,
    14% {
      background: color-mix(in srgb, var(--accent-3) 12%, transparent);
    }
    20% {
      background: transparent;
    }
  }
</style>
