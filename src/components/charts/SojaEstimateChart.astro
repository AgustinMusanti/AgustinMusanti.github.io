---
import ChartFrame from './ChartFrame.astro';
import soja from '../../data/soja.json';
import { scale, ticks } from '../../lib/chart';
import { useTranslations, formatNumber, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const t = useTranslations(lang).soja;
const fmt = (v: number) => formatNumber(v, lang);

const nov = soja.current.estimates.find((e) => e.window === 'oct_nov')!;
const points = [
  ...soja.seasons.map((s) => ({ ...s, current: false, low: null as number | null, high: null as number | null })),
  { id: soja.current.id, observed: null, estimateNov: nov.estimate, current: true, low: nov.low, high: nov.high },
];

// Bars encode magnitude, so the axis starts at zero.
const Y_MIN = 0;
const Y_MAX = 40;

function layout(w: number, h: number, m: { l: number; r: number; t: number; b: number }) {
  const x = (i: number) => m.l + ((i + 0.5) * (w - m.l - m.r)) / points.length;
  const y = scale([Y_MIN, Y_MAX], [h - m.b, m.t]);
  const band = (w - m.l - m.r) / points.length;
  return { w, h, m, x, y, band };
}

const variants = [
  { cls: 'hidden sm:block', ...layout(640, 280, { l: 34, r: 8, t: 12, b: 30 }), font: 12, labelEvery: 1 },
  { cls: 'sm:hidden', ...layout(340, 240, { l: 28, r: 4, t: 12, b: 28 }), font: 11, labelEvery: 2 },
];

// Narrow charts label every other season, counted from the highlighted drought so it is always labeled.
const HIGHLIGHT = '2022/23';
const highlightIndex = points.findIndex((p) => p.id === HIGHLIGHT);
const short = (id: string) => id.replace(/^20(\d\d)\/(\d\d)$/, '$1/$2');
const estimatePath = (v: (typeof variants)[number]) =>
  points.map((p, i) => `${i ? 'L' : 'M'}${v.x(i).toFixed(1)},${v.y(p.estimateNov).toFixed(1)}`).join(' ');
const tip = (p: (typeof points)[number]) =>
  p.current
    ? `${p.id} · ${t.estimate}: ${fmt(p.estimateNov)} (${fmt(p.low!)}–${fmt(p.high!)}) · ${t.current}`
    : `${p.id} · ${t.observed}: ${fmt(p.observed!)} · ${t.estimate}: ${fmt(p.estimateNov)}`;
---

<ChartFrame title={t.chartTitle} subtitle={t.chartSubtitle}>
  {variants.map((v) => (
    <svg class:list={['block h-auto w-full', v.cls]} viewBox={`0 0 ${v.w} ${v.h}`} aria-hidden="true">
      {ticks(Y_MIN, Y_MAX, 10).map((tk) => (
        <g>
          <line x1={v.m.l} x2={v.w - v.m.r} y1={v.y(tk)} y2={v.y(tk)} stroke="var(--border)" stroke-width="1" />
          <text x={v.m.l - 6} y={v.y(tk) + 4} text-anchor="end" class="num" font-size={v.font} fill="var(--muted)">
            {tk}
          </text>
        </g>
      ))}
      {points.map((p, i) =>
        p.observed === null ? (
          <rect
            x={v.x(i) - v.band * 0.18}
            width={v.band * 0.36}
            y={v.y(p.high!)}
            height={v.y(p.low!) - v.y(p.high!)}
            rx="3"
            fill="var(--chart-uncertainty)"
            class="draw-fade"
          />
        ) : (
          <rect
            x={v.x(i) - v.band * 0.3}
            width={v.band * 0.6}
            y={v.y(p.observed)}
            height={v.y(Y_MIN) - v.y(p.observed)}
            rx="2"
            fill={p.id === HIGHLIGHT ? 'var(--chart-highlight)' : 'var(--chart-secondary)'}
            class="draw-bar"
            style={`--i:${i}`}
          />
        ),
      )}
      <path
        d={estimatePath(v)}
        fill="none"
        stroke="var(--chart-primary)"
        stroke-width="2"
        pathLength="1"
        class="draw-line"
      />
      {points.map((p, i) => (
        <circle
          cx={v.x(i)}
          cy={v.y(p.estimateNov)}
          r={p.current ? 5 : 4}
          fill={p.current ? 'var(--surface)' : 'var(--chart-primary)'}
          stroke="var(--chart-primary)"
          stroke-width="2"
          class="draw-fade"
        />
      ))}
      {points.map((p, i) =>
        Math.abs(i - highlightIndex) % v.labelEvery === 0 ? (
          <text
            x={v.x(i)}
            y={v.h - 8}
            text-anchor="middle"
            class="num"
            font-size={v.font}
            fill={p.id === HIGHLIGHT ? 'var(--text)' : 'var(--muted)'}
          >
            {short(p.id)}
          </text>
        ) : null,
      )}
      {points.map((p, i) => (
        <rect
          x={v.x(i) - v.band / 2}
          width={v.band}
          y={v.m.t}
          height={v.h - v.m.t - v.m.b}
          fill="transparent"
          data-tip={tip(p)}
        />
      ))}
    </svg>
  ))}
  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-[var(--muted)]" aria-hidden="true">
    <li class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-sm bg-[var(--chart-secondary)]"></span>
      {t.observed}
    </li>
    <li class="flex items-center gap-2">
      <span class="inline-block h-0.5 w-4 bg-[var(--chart-primary)]"></span>
      <span class="-ml-3 mr-1 inline-block h-2 w-2 rounded-full bg-[var(--chart-primary)]"></span>
      {t.estimate}
    </li>
    <li class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 rounded-sm bg-[var(--chart-uncertainty)]"></span>
      {t.interval}
    </li>
  </ul>
  <div class="sr-only">
    <table>
      <caption>{t.tableCaption}</caption>
      <thead>
        <tr>
          <th scope="col">{t.season}</th>
          <th scope="col">{t.observed}</th>
          <th scope="col">{t.estimate}</th>
        </tr>
      </thead>
      <tbody>
        {points.map((p) => (
          <tr>
            <th scope="row">{p.id}</th>
            <td>{p.observed === null ? t.current : fmt(p.observed)}</td>
            <td>{p.current ? `${fmt(p.estimateNov)} (${fmt(p.low!)}–${fmt(p.high!)})` : fmt(p.estimateNov)}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</ChartFrame>
