---
const bars = [0.55, 0.8, 0.45, 0.7, 0.95, 0.6, 0.75];
---

<svg class="block h-auto w-full max-w-sm" viewBox="0 0 340 150" aria-hidden="true">
  <rect x="1" y="1" width="338" height="148" rx="8" fill="none" stroke="var(--border)" />
  {[0, 1, 2].map((i) => (
    <rect x={14 + i * 106} y="14" width="96" height="30" rx="4" fill="var(--bar)" opacity="0.6" />
  ))}
  {bars.map((v, i) => (
    <rect x={20 + i * 26} y={136 - v * 76} width="16" height={v * 76} rx="2" fill="var(--bar)" />
  ))}
  <polyline
    points="214,118 238,104 262,110 286,86 310,92 326,70"
    fill="none"
    stroke="var(--accent-3)"
    stroke-width="2"
  />
  <line x1="208" x2="330" y1="136" y2="136" stroke="var(--border)" />
</svg>
