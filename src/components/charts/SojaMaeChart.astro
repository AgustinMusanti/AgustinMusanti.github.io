---
import ChartFrame from './ChartFrame.astro';
import soja from '../../data/soja.json';
import { scale } from '../../lib/chart';
import { useTranslations, formatNumber, type Language } from '../../i18n/utils';

interface Props {
  lang: Language;
  size?: 'lg' | 'sm';
}

const { lang, size = 'lg' } = Astro.props;
const t = useTranslations(lang).soja;
const fmt = (v: number) => formatNumber(v, lang, 2);

const w = 340;
const h = size === 'lg' ? 190 : 160;
const m = { l: 6, r: 6, t: 22, b: 30 };
const rows = soja.maeByWindow;
const band = (w - m.l - m.r) / rows.length;
const x = (i: number) => m.l + (i + 0.5) * band;
const y = scale([0, 4.6], [h - m.b, m.t]);
const before = (n: number) => `${n} ${n === 1 ? t.monthBefore : t.monthsBefore}`;
const best = Math.min(...rows.map((r) => r.mae));
---

<ChartFrame title={t.maeTitle} subtitle={t.maeSubtitle} size={size}>
  <svg class="block h-auto w-full" viewBox={`0 0 ${w} ${h}`} aria-hidden="true">
    <line
      x1={m.l}
      x2={w - m.r}
      y1={y(soja.baselineMae)}
      y2={y(soja.baselineMae)}
      stroke="var(--muted)"
      stroke-dasharray="4 4"
    />
    <text x={w - m.r} y={y(soja.baselineMae) - 6} text-anchor="end" font-size="10" fill="var(--muted)">
      {t.maeBaseline}: <tspan class="num">{fmt(soja.baselineMae)}</tspan>
    </text>
    {rows.map((r, i) => (
      <g>
        <rect
          x={x(i) - band * 0.3}
          width={band * 0.6}
          y={y(r.mae)}
          height={y(0) - y(r.mae)}
          rx="2"
          class="draw-bar"
          style={`--i:${i}`}
          fill={r.mae === best ? 'var(--chart-highlight)' : 'var(--chart-secondary)'}
          data-tip={`${t.windows[r.window]} · ${before(r.mesesAntes)} · MAE ${fmt(r.mae)} qq/ha`}
        />
        <text x={x(i)} y={y(r.mae) - 5} text-anchor="middle" class="num" font-size="10.5" fill="var(--text)">
          {fmt(r.mae)}
        </text>
        <text x={x(i)} y={h - 16} text-anchor="middle" font-size="10" fill="var(--muted)">
          {t.windows[r.window]}
        </text>
        <text x={x(i)} y={h - 4} text-anchor="middle" class="num" font-size="9.5" fill="var(--muted)">
          {`−${r.mesesAntes}m`}
        </text>
      </g>
    ))}
  </svg>
  <div class="sr-only">
    <table>
      <caption>{t.maeSubtitle}</caption>
      <tbody>
        {rows.map((r) => (
          <tr>
            <th scope="row">
              {t.windows[r.window]} ({before(r.mesesAntes)})
            </th>
            <td>{fmt(r.mae)} qq/ha</td>
          </tr>
        ))}
        <tr>
          <th scope="row">{t.maeBaseline}</th>
          <td>{fmt(soja.baselineMae)} qq/ha</td>
        </tr>
      </tbody>
    </table>
  </div>
</ChartFrame>
