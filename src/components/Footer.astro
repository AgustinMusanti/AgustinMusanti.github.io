---
import { getProfile } from '../lib/content';
import type { Language } from '../i18n/utils';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { name, location } = await getProfile(lang);
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl border-t border-[var(--border)] px-4 py-8 text-sm text-[var(--muted)]">
  <p>
    © {year} {name} · {location}
  </p>
</footer>
