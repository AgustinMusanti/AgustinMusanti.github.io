---
interface Props {
  repoUrl: string;
}

const { repoUrl } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-5xl border-t border-[var(--border)] px-4 py-8 text-sm text-[var(--muted)]">
  <p>© {year} Agustín Musanti · La Plata, Argentina</p>
  <p class="mt-1">
    Hecho con Astro, deployado con GitHub Actions ·
    <a href={repoUrl} class="underline hover:text-[var(--text)]" target="_blank" rel="noopener noreferrer">
      repo del sitio
    </a>
  </p>
</footer>
